#!/usr/bin/env bash
# aios-claude — account-aware Claude Code launcher.
#
# Reads $AIOS_ACCOUNT; if set, loads the matching token from
# $HOME/.aios-accounts/<name>.token and exports CLAUDE_CODE_OAUTH_TOKEN
# before execing `claude`. If $AIOS_ACCOUNT is empty, falls through to
# Claude Code's default auth (its stored login: the Keychain on macOS,
# ~/.claude/.credentials.json on Linux/WSL; error if never logged in).
#
# Opt-out: $AIOS_REMOTE_CONTROL=1 skips the token export AND unsets any
# inherited CLAUDE_CODE_OAUTH_TOKEN, so Claude Code reads the stored
# claude.ai credential directly. Required for /remote-control, which
# rejects CLAUDE_CODE_OAUTH_TOKEN as inference-only by policy regardless
# of the token's underlying scope. Use this when you need full-scope
# OAuth features (Remote Control, etc.) inside an aios-launched session.
#
# Installed to $HOME/.aios-claude on every machine fleetmux manages.
# Deployed by `fleetmux account sync`.

set -e

account="${AIOS_ACCOUNT:-}"

if [[ "${AIOS_REMOTE_CONTROL:-}" == "1" ]]; then
    unset CLAUDE_CODE_OAUTH_TOKEN
    echo "[aios-claude] AIOS_REMOTE_CONTROL=1 — using stored login (no CLAUDE_CODE_OAUTH_TOKEN export)" >&2
elif [[ -n "$account" ]]; then
    token_file="${HOME}/.aios-accounts/${account}.token"
    if [[ -r "$token_file" ]]; then
        CLAUDE_CODE_OAUTH_TOKEN="$(tr -d '[:space:]' < "$token_file")"
        export CLAUDE_CODE_OAUTH_TOKEN
    else
        echo "[aios-claude] WARN: account '$account' token not found at $token_file — falling back to default auth" >&2
    fi
fi

CLAUDE_BIN="${HOME}/.local/bin/claude"
if [[ ! -x "$CLAUDE_BIN" ]]; then
    CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"
fi
if [[ -z "$CLAUDE_BIN" ]]; then
    echo "[aios-claude] ERROR: claude not found in ~/.local/bin or PATH" >&2
    exit 1
fi

exec "$CLAUDE_BIN" "$@"
